{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/docs": { "entry": ["src/routeData.ts"] },
    "apps/example-html": { "ignoreDependencies": ["consentlayer"] },
    "apps/example-nuxt": {
      "entry": ["app/consentlayer.config.ts", "app/components/**/*.vue"],
      "ignoreDependencies": ["vue-router", "vue-tsc"]
    },
    "apps/example-solidstart": {
      "vite": false,
      "entry": ["vite.config.ts", "src/app.tsx", "src/entry-{client,server}.tsx", "src/routes/**/*.tsx"]
    },
    "apps/example-sveltekit": { "entry": ["src/env.ts"] },
    "packages/consentlayer": { "entry": ["test/svelte/app-navigation.ts"], "ignoreUnresolved": ["\\$app/navigation"] }
  }
}
