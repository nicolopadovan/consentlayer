{
  "name": "consentlayer",
  "version": "1.0.0-rc.1",
  "description": "Consent-first analytics for the browser and server: one API in front of GA4, Meta, PostHog, Sentry and more, gated by the visitor's consent.",
  "keywords": [
    "consent",
    "cookie-consent",
    "gdpr",
    "analytics",
    "ga4",
    "meta-pixel",
    "conversions-api",
    "posthog",
    "sentry",
    "nextjs",
    "react"
  ],
  "type": "module",
  "license": "MIT",
  "author": "nicolopadovan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolopadovan/analytics-consent-manager-npm.git",
    "directory": "packages/consentlayer"
  },
  "homepage": "https://consentlayer.vercel.app",
  "bugs": "https://github.com/nicolopadovan/analytics-consent-manager-npm/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ecommerce": {
      "types": "./dist/ecommerce.d.ts",
      "import": "./dist/ecommerce.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./providers/meta": {
      "types": "./dist/providers/meta.d.ts",
      "import": "./dist/providers/meta.js"
    },
    "./providers/ga4": {
      "types": "./dist/providers/ga4.d.ts",
      "import": "./dist/providers/ga4.js"
    },
    "./providers/shopify": {
      "types": "./dist/providers/shopify.d.ts",
      "import": "./dist/providers/shopify.js"
    },
    "./providers/contentsquare": {
      "types": "./dist/providers/contentsquare.d.ts",
      "import": "./dist/providers/contentsquare.js"
    },
    "./providers/hotjar": {
      "types": "./dist/providers/hotjar.d.ts",
      "import": "./dist/providers/hotjar.js"
    },
    "./providers/posthog": {
      "types": "./dist/providers/posthog.d.ts",
      "import": "./dist/providers/posthog.js"
    },
    "./providers/sentry": {
      "types": "./dist/providers/sentry.d.ts",
      "import": "./dist/providers/sentry.js"
    },
    "./providers/vercel": {
      "types": "./dist/providers/vercel.d.ts",
      "import": "./dist/providers/vercel.js"
    },
    "./providers/tiktok": {
      "types": "./dist/providers/tiktok.d.ts",
      "import": "./dist/providers/tiktok.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/ga4": {
      "types": "./dist/server/ga4.d.ts",
      "import": "./dist/server/ga4.js"
    },
    "./server/meta": {
      "types": "./dist/server/meta.d.ts",
      "import": "./dist/server/meta.js"
    },
    "./sentry/server": {
      "types": "./dist/sentry/server.d.ts",
      "import": "./dist/sentry/server.js"
    },
    "./sentry/next": {
      "types": "./dist/sentry/next.d.ts",
      "import": "./dist/sentry/next.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only && size-limit"
  },
  "peerDependencies": {
    "@sentry/browser": "^11.0.0",
    "@sentry/nextjs": "^11.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "posthog-js": "^1.438.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@sentry/browser": {
      "optional": true
    },
    "@sentry/nextjs": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "posthog-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@sentry/browser": "^11.7.0",
    "@sentry/nextjs": "^11.7.0",
    "@size-limit/esbuild": "^14.2.0",
    "@size-limit/file": "^14.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "next": "16.1.4",
    "posthog-js": "^1.438.9",
    "publint": "^0.3.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^14.2.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
