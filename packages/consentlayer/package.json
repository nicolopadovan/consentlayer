{
  "name": "consentlayer",
  "version": "1.0.0-rc.0",
  "description": "Consent-first analytics for the browser and server: one API in front of GA4, Meta, PostHog, Sentry and more, gated by the visitor's consent.",
  "keywords": [
    "consent",
    "cookie-consent",
    "gdpr",
    "analytics",
    "ga4",
    "meta-pixel",
    "conversions-api",
    "posthog",
    "sentry",
    "nextjs",
    "react",
    "vue",
    "nuxt",
    "svelte",
    "sveltekit",
    "solid",
    "solidstart",
    "angular"
  ],
  "type": "module",
  "license": "MIT",
  "author": "nicolopadovan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolopadovan/consentlayer.git",
    "directory": "packages/consentlayer"
  },
  "homepage": "https://consentlayer.nicolopadovan.com",
  "bugs": "https://github.com/nicolopadovan/consentlayer/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 94",
    "edge >= 94",
    "firefox >= 93",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/consentlayer.global.js",
