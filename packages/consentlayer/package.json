    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts && mkdir -p dist/svelte && cp src/svelte/MetaPixelNoscript.svelte src/svelte/GtmNoscript.svelte dist/svelte/",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only && size-limit && es-check checkBrowser --module --checkBrowser 'dist/**/*.js' --not dist/server,dist/nuxt,dist/sentry/server.js,dist/sentry/next.js"
  },
